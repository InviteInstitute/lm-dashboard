# Copy to .env.mirror and fill in. The daemon needs the prod-hub creds below (it
# mirrors events from the prod VEX hub); both processes need DATABASE_URL.

# Postgres connection string (both the API and the daemon use it). For local dev
# this points at the postgres:latest Docker container (see README Quick Start).
DATABASE_URL=postgresql://lmdash:CHANGE_ME@127.0.0.1:5432/lm_dashboard

# Secret for signing researcher session cookies (API). Use a long random value,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=

# Prod VEX hub credentials (ingestion daemon). INTERIM: these also seed the shared
# researcher dashboard login on startup (log in with PROD_USERNAME / PROD_PASSWORD)
# until per-researcher accounts + the login screen ship. See app/auth.py.
VEX_PROD_API_BASE=https://inviteinstitutehub.org
PROD_USERNAME=
PROD_PASSWORD=

# Optional overrides
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# PIPELINE_INTERVAL=0.5
# PIPELINE_PAGE_LIMIT=500
