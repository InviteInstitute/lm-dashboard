# Copy to .env.mirror and fill in the app secrets below.
#
# Running with docker compose (the normal way -- see README): you ALSO create a
# small `.env` file next to compose.yml with just:
#     POSTGRES_PASSWORD=<pick one>
# Compose builds DATABASE_URL for you (pointing at the `db` service), so you do
# NOT set DATABASE_URL here in that case.
#
# Running from a local venv instead (no compose): set DATABASE_URL here to point
# at your Postgres, e.g.
#     DATABASE_URL=postgresql://lmdash:CHANGE_ME@127.0.0.1:5432/lm_dashboard

# Secret for signing researcher session cookies (API). Use a long random value,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SESSION_SECRET=

# Prod VEX hub credentials (ingestion daemon). INTERIM: these also seed the shared
# researcher login (sign in on the login screen with PROD_USERNAME / PROD_PASSWORD);
# create real per-researcher accounts with scripts/create_researcher.py. See app/auth.py.
VEX_PROD_API_BASE=https://inviteinstitutehub.org
PROD_USERNAME=
PROD_PASSWORD=

# Optional overrides
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# PIPELINE_INTERVAL=0.5
# PIPELINE_PAGE_LIMIT=500
